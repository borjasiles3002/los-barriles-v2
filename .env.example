# ─── Firebase (cliente) ────────────────────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → General → Your apps → Web app

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# El primer usuario que inicie sesión con este email recibirá el rol 'admin'.
VITE_ADMIN_EMAIL=admin@turestaurante.com

# ─── Gemini (SOLO servidor — Vercel Function) ──────────────────────────────────
# ⚠️  Esta clave NO lleva prefijo VITE_ → nunca se expone al cliente.
# Añádela en Vercel Dashboard → Project → Settings → Environment Variables
# Get it from: aistudio.google.com → Get API Key

GEMINI_API_KEY=your_gemini_api_key_here
